{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Schema Commander",
  "version": "../package.json",
  "identifier": "io.github.krocon.schemacommander",
  "build": {
    "frontendDist": "../dist/schema-commander/browser",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Schema Commander",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "backgroundColor": "#14171c",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "msi", "nsis"],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/schema-commander",
    "category": "DeveloperTool",
    "shortDescription": "Keyboard-driven SQL client",
    "longDescription": "Schema Commander is a fast, keyboard-driven SQL client for macOS, Windows and Linux: browse schemas, write SQL in an editor made for huge texts and look at millions of result rows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    }
  }
}
