{
  "comment": "script → statements per dialect. `all` = the same in every dialect.",
  "cases": [
    {
      "name": "semicolons, empty parts dropped",
      "dialect": "all",
      "script": "select 1; select 2;;\n",
      "statements": ["select 1", "select 2"]
    },
    {
      "name": "no terminator at the end",
      "dialect": "all",
      "script": "select 1;\nselect 2",
      "statements": ["select 1", "select 2"]
    },
    {
      "name": "semicolon in a string",
      "dialect": "all",
      "script": "select 'a;b'; select 2",
      "statements": ["select 'a;b'", "select 2"]
    },
    {
      "name": "doubled quote in a string",
      "dialect": "all",
      "script": "select 'it''s; fine'; select 2",
      "statements": ["select 'it''s; fine'", "select 2"]
    },
    {
      "name": "semicolon in a quoted name",
      "dialect": "all",
      "script": "select \"c;d\" from t; select 2",
      "statements": ["select \"c;d\" from t", "select 2"]
    },
    {
      "name": "line comment",
      "dialect": "all",
      "script": "select 1 -- no; split\nfrom t; select 2",
      "statements": ["select 1 -- no; split\nfrom t", "select 2"]
    },
    {
      "name": "block comment",
      "dialect": "all",
      "script": "select 1 /* nor; here */ from t; select 2",
      "statements": ["select 1 /* nor; here */ from t", "select 2"]
    },
    {
      "name": "unterminated string",
      "dialect": "all",
      "script": "select 'open; x",
      "statements": ["select 'open; x"]
    },
    {
      "name": "unterminated comment",
      "dialect": "all",
      "script": "select 1 /* open; x",
      "statements": ["select 1 /* open; x"]
    },
    {
      "name": "only comments and blanks",
      "dialect": "all",
      "script": "  \n-- nothing\n",
      "statements": ["-- nothing"]
    },

    {
      "name": "dollar quoting",
      "dialect": "postgres",
      "script": "create function f() returns int as $$ begin return 1; end; $$ language plpgsql; select f()",
      "statements": [
        "create function f() returns int as $$ begin return 1; end; $$ language plpgsql",
        "select f()"
      ]
    },
    {
      "name": "tagged dollar quoting with inner $$",
      "dialect": "postgres",
      "script": "do $body$ begin perform $$a;b$$; end $body$; select 1",
      "statements": ["do $body$ begin perform $$a;b$$; end $body$", "select 1"]
    },
    {
      "name": "dollar parameter is no quote",
      "dialect": "postgres",
      "script": "select $1; select $2",
      "statements": ["select $1", "select $2"]
    },
    {
      "name": "dollar inside a name is no quote",
      "dialect": "postgres",
      "script": "select a$b$c; select 2",
      "statements": ["select a$b$c", "select 2"]
    },
    {
      "name": "E string with backslash quote",
      "dialect": "postgres",
      "script": "select E'it\\'s; ok'; select 2",
      "statements": ["select E'it\\'s; ok'", "select 2"]
    },
    {
      "name": "plain string keeps its backslash",
      "dialect": "postgres",
      "script": "select 'a\\'; select 2",
      "statements": ["select 'a\\'", "select 2"]
    },
    {
      "name": "nested block comments",
      "dialect": "postgres",
      "script": "select 1 /* a /* b; */ c; */; select 2",
      "statements": ["select 1 /* a /* b; */ c; */", "select 2"]
    },
    {
      "name": "backtick is nothing special",
      "dialect": "postgres",
      "script": "select '`'; select 2",
      "statements": ["select '`'", "select 2"]
    },

    {
      "name": "backticks",
      "dialect": "mysql",
      "script": "select `a;b` from t; select 2",
      "statements": ["select `a;b` from t", "select 2"]
    },
    {
      "name": "hash comment",
      "dialect": "mysql",
      "script": "select 1 # no; split\n; select 2",
      "statements": ["select 1 # no; split", "select 2"]
    },
    {
      "name": "backslash escape in a string",
      "dialect": "mysql",
      "script": "select 'it\\'s; ok'; select 2",
      "statements": ["select 'it\\'s; ok'", "select 2"]
    },
    {
      "name": "DELIMITER",
      "dialect": "mysql",
      "script": "DELIMITER //\ncreate procedure p() begin select 1; select 2; end//\nDELIMITER ;\ncall p();",
      "statements": ["create procedure p() begin select 1; select 2; end", "call p()"]
    },
    {
      "name": "DELIMITER with dollar signs",
      "dialect": "mysql",
      "script": "delimiter $$\nselect 1; select 2$$\nselect 3$$",
      "statements": ["select 1; select 2", "select 3"]
    },
    {
      "name": "delimiter as a column name is no command",
      "dialect": "mysql",
      "script": "select delimiter from t; select 2",
      "statements": ["select delimiter from t", "select 2"]
    },

    {
      "name": "bracket names",
      "dialect": "sqlserver",
      "script": "select [a;b] from t; select 2",
      "statements": ["select [a;b] from t", "select 2"]
    },
    {
      "name": "GO ends a statement",
      "dialect": "sqlserver",
      "script": "select 1\nGO\nselect 2\ngo\n",
      "statements": ["select 1", "select 2"]
    },
    {
      "name": "GO inside a line is a name",
      "dialect": "sqlserver",
      "script": "select go from t; select 2",
      "statements": ["select go from t", "select 2"]
    },
    {
      "name": "GO in a string or comment is text",
      "dialect": "sqlserver",
      "script": "select '\nGO\n'; /*\nGO\n*/ select 2",
      "statements": ["select '\nGO\n'", "/*\nGO\n*/ select 2"]
    },

    {
      "name": "trigger keeps its inner statements",
      "dialect": "sqlite",
      "script": "create trigger t after insert on a begin update b set n = n + 1; insert into log values (1); end; select 1",
      "statements": [
        "create trigger t after insert on a begin update b set n = n + 1; insert into log values (1); end",
        "select 1"
      ]
    },
    {
      "name": "trigger with CASE … END inside",
      "dialect": "sqlite",
      "script": "create temp trigger t after update on a begin update b set n = case when 1 then 2 else 3 end; end; select 1",
      "statements": [
        "create temp trigger t after update on a begin update b set n = case when 1 then 2 else 3 end; end",
        "select 1"
      ]
    },
    {
      "name": "BEGIN of a transaction is no block",
      "dialect": "sqlite",
      "script": "begin; insert into t values (1); end; select 1",
      "statements": ["begin", "insert into t values (1)", "end", "select 1"]
    },
    {
      "name": "bracket names in sqlite",
      "dialect": "sqlite",
      "script": "select [a;b] from t; select 2",
      "statements": ["select [a;b] from t", "select 2"]
    }
  ]
}
